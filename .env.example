# ==============================================================================
# InsightForge AI - Environment Configuration Example
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI PROVIDER API KEYS
# Leave a key blank to disable that provider. The app works with as few as
# ONE configured provider, but at least one is required for research to run.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# AI PROVIDER MODELS
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# PROVIDER FALLBACK CHAIN
# The app tries PRIMARY first, then FALLBACK, then SECONDARY_FALLBACK.
# Valid values: openai | anthropic | gemini
# ------------------------------------------------------------------------------
PRIMARY_AI_PROVIDER=openai
FALLBACK_AI_PROVIDER=anthropic
SECONDARY_FALLBACK_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# TASK -> PROVIDER ROUTING
# Assign which provider handles each stage of the research pipeline.
# Any value here can also be "auto" to use the PRIMARY/FALLBACK chain above.
# ------------------------------------------------------------------------------
PLANNING_PROVIDER=openai
ANALYSIS_PROVIDER=anthropic
CROSSCHECK_PROVIDER=gemini
SYNTHESIS_PROVIDER=anthropic

# ------------------------------------------------------------------------------
# WEB SEARCH
# Default search backend requires no API key (DuckDuckGo via the ddgs
# package). Optionally set a Tavily key for higher-quality search results.
# ------------------------------------------------------------------------------
SEARCH_BACKEND=duckduckgo
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# AGENT / COST SAFETY LIMITS
# ------------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=20
MAX_SOURCES=10
MAX_RESEARCH_TASKS=8
MAX_TOKENS_PER_REQUEST=4000
REQUEST_TIMEOUT_SECONDS=30
MAX_PROVIDER_RETRIES=2
PROVIDER_FALLBACK_LIMIT=3

# ------------------------------------------------------------------------------
# DATABASE
# SQLite by default. Point this at a postgres:// URL in production
# (Render/Railway provide one automatically when you attach a Postgres addon).
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/insightforge.db

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-string-in-production
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=1048576
PORT=8000
